# Adonis Environment Configuration
DEBUG=True
SECRET_KEY=adonis-super-secret-key-change-in-production-2026!@#$%^
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback)
# Set to True or provide DB_NAME/DB_USER/DB_PASSWORD/DB_HOST to use PostgreSQL
USE_POSTGRES=False
DB_NAME=adonis_db
DB_USER=adonis_user
DB_PASSWORD=adonis_password
DB_HOST=db
DB_PORT=5432

# JWT Security
JWT_SECRET=adonis-jwt-secret-key-ultra-secure-auth-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=43200

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Open Food Facts API
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
